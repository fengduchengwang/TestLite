<view class="edit-page">
  <view class="edit-section">
    <text class="edit-label">头像</text>
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <t-avatar image="{{avatarUrl}}" icon="user" size="large" />
      <text class="avatar-btn__tip">点击更换</text>
    </button>
  </view>
  <view class="edit-section">
    <text class="edit-label">昵称</text>
    <input
      class="nickname-input"
      type="nickname"
      value="{{nickName}}"
      placeholder="请输入昵称"
      bind:input="onNicknameInput"
    />
  </view>
  <button class="save-btn" bindtap="onSave">保存</button>
</view>
