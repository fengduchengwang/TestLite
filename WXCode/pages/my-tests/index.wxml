<t-navbar title="我的测试" left-arrow />
<view class="record-page">
  <view wx:if="{{cardInfo.length === 0}}" class="record-empty">暂无已测试记录</view>
  <view wx:else class="record-list">
    <card
      wx:for="{{cardInfo}}"
      wx:key="id"
      test-id="{{item.id}}"
      title="{{item.title}}"
      subtitle="{{item.subtitle}}"
      question-count="{{item.questionCount}}"
      duration="{{item.duration}}"
      image-link="{{item.imageLink}}"
      test-link="{{item.testLink}}"
      quiz-key="{{item.quizKey}}"
      tested="{{item.tested}}"
      followed="{{item.followed}}"
      action-mode="follow"
      bind:tested="onTested"
      bind:follow="onFollow"
      bind:unfollow="onUnfollow"
    />
  </view>
</view>
