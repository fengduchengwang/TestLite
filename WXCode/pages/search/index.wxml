<view class="search-page">
  <view class="search-navbar">
    <t-navbar>
      <view slot="left">
        <view class="search-navbar__left">
          <view class="search-navbar__back" bindtap="handleBack">
            <t-icon name="chevron-left" size="48rpx" />
          </view>
          <t-search
            value="{{searchValue}}"
            leftIcon="search"
            shape="round"
            placeholder="搜索测试、关键词"
            bind:submit="handleSubmit"
            bind:change="handleChange"
            focus
          />
        </view>
      </view>
    </t-navbar>
  </view>

  <view class="search-body">
    <view class="search-section">
      <view class="search-section__title">热门搜索</view>
      <view class="hot-tags">
        <view
          wx:for="{{hotTags}}"
          wx:key="*this"
          class="hot-tag"
          data-keyword="{{item}}"
          bindtap="handleHotTap"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="search-section">
      <view class="search-section__title">历史记录</view>
      <view wx:if="{{historyWords.length === 0}}" class="search-empty">暂无历史记录</view>
      <view wx:else class="history-list">
        <view wx:for="{{historyWords}}" wx:key="*this" class="history-item">
          <text class="history-item__text" data-keyword="{{item}}" bindtap="handleHistoryTap">{{item}}</text>
          <t-icon
            name="close"
            size="32rpx"
            class="history-item__close"
            data-index="{{index}}"
            catch:tap="handleDeleteHistory"
          />
        </view>
      </view>
    </view>
  </view>
</view>
