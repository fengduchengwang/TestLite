<t-navbar title="搜索结果" left-arrow />
<view class="result-page">
  <view wx:if="{{results.length === 0}}" class="result-empty">暂无「{{keyword}}」相关测试</view>
  <view wx:else class="result-cards">
    <card
      wx:for="{{results}}"
      wx:key="id"
      test-id="{{item.id}}"
      title="{{item.title}}"
      subtitle="{{item.subtitle}}"
      question-count="{{item.questionCount}}"
      duration="{{item.duration}}"
      image-link="{{item.imageLink}}"
      test-link="{{item.testLink}}"
      tested="{{item.tested}}"
      followed="{{item.followed}}"
      action-mode="follow"
      bind:tested="onTested"
      bind:follow="onFollow"
      bind:unfollow="onUnfollow"
    />
  </view>
</view>
