<view class="analyzing">
  <view class="quiz-loader" wx:if="{{!retry}}">
    <view class="quiz-loader__ring quiz-loader__ring--outer"></view>
    <view class="quiz-loader__ring quiz-loader__ring--inner"></view>
  </view>
  <view class="analyzing__title">{{retry ? '测试结果已准备好' : '正在整理你的测试结果'}}</view>
  <view class="analyzing__message">{{message}}</view>
  <button class="quiz-primary analyzing__retry" wx:if="{{retry}}" bindtap="goResult">重新打开结果</button>
</view>
