<nav nav-type="search" />
<view class="home-page">
  <scroll-view
    scroll-y
    class="home-scroll"
    style="height: {{scrollHeight}}px"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="home-card-list">
      <view class="home-banner">
        <t-swiper
          list="{{swiperList}}"
          navigation="{{ { type: 'dots-bar' } }}"
          height="360rpx"
          autoplay="{{true}}"
          interval="{{3000}}"
          duration="{{500}}"
          bind:click="onSwiperClick"
        />
      </view>

      <view class="home-category">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="home-category__item {{activeCategory === item.value ? 'home-category__item--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onCategoryTap"
        >
          {{item.label}}
        </view>
      </view>

      <view class="home-list">
        <card
          wx:for="{{cardInfo}}"
          wx:key="id"
          test-id="{{item.id}}"
          title="{{item.title}}"
          subtitle="{{item.subtitle}}"
          question-count="{{item.questionCount}}"
          duration="{{item.duration}}"
          url="{{item.url}}"
          link="{{item.link}}"
          tested="{{item.tested}}"
          followed="{{item.followed}}"
          action-mode="follow"
          tags="{{item.tags}}"
          bind:tested="onTested"
          bind:follow="onFollow"
          bind:unfollow="onUnfollow"
        />
      </view>
    </view>
  </scroll-view>
</view>
