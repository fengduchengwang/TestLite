<nav title-text="关注" />
<view class="follow-page">
  <scroll-view
    scroll-y
    class="follow-scroll"
    style="height: {{scrollHeight}}px"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="follow-list">
      <view wx:if="{{cardInfo.length === 0}}" class="follow-empty">暂无关注的测试</view>
      <card
        wx:for="{{cardInfo}}"
        wx:key="id"
        test-id="{{item.id}}"
        title="{{item.title}}"
        subtitle="{{item.subtitle}}"
        question-count="{{item.questionCount}}"
        duration="{{item.duration}}"
        url="{{item.url}}"
        link="{{item.link}}"
        tested="{{item.tested}}"
        tags="{{item.tags}}"
        bind:tested="onTested"
      />
    </view>
  </scroll-view>
</view>
