{
  "pages": [
    "pages/home/index",
    "pages/follow/index",
    "pages/my/index",
    "pages/my-tests/index",
    "pages/my-history/index",
    "pages/my/info-edit/index"
  ],
  "lazyCodeLoading": "requiredComponents",
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["pages/quiz"]
    }
  },
  "usingComponents": {
    "t-toast": "tdesign-miniprogram/toast/toast"
  },
  "subpackages": [
    {
      "root": "pages/search",
      "name": "search",
      "pages": ["index", "result/index"]
    },
    {
      "root": "pages/quiz",
      "name": "quiz",
      "pages": [
        "intro/index",
        "play/index",
        "play/index01",
        "play/index02",
        "play/index03",
        "play/index04",
        "play/index05",
        "play/index06",
        "play/index07",
        "play/index08",
        "play/index09",
        "play/index10",
        "play/index11",
        "play/index12",
        "play/index13",
        "play/index14",
        "play/index15",
        "play/index16",
        "play/index17",
        "play/index18",
        "play/index19",
        "play/index20",
        "play/index21",
        "play/index22",
        "play/index23",
        "play/index24",
        "play/index25",
        "play/index26",
        "play/index27",
        "play/index28",
        "play/index29",
        "play/index30",
        "analyzing/index",
        "result/index"
      ]
    },
    {
      "root": "pages/webview",
      "name": "webview",
      "pages": ["index"]
    },
    {
      "root": "pages/setting",
      "name": "setting",
      "pages": ["index"]
    }
  ],
  "window": {
    "backgroundTextStyle": "light",
    "backgroundColor": "#0b0e16",
    "backgroundColorContent": "#0b0e16",
    "backgroundColorTop": "#0b0e16",
    "backgroundColorBottom": "#0b0e16",
    "navigationBarBackgroundColor": "#0b0e16",
    "navigationBarTitleText": "心理测试",
    "navigationBarTextStyle": "white"
  },
  "tabBar": {
    "custom": true,
    "backgroundColor": "#141827",
    "color": "#8e97aa",
    "selectedColor": "#8ab8ee",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/follow/index",
        "text": "关注"
      },
      {
        "pagePath": "pages/my/index",
        "text": "我的"
      }
    ]
  },
  "resolveAlias": {
    "~/*": "/*"
  },
  "sitemapLocation": "sitemap.json"
}
