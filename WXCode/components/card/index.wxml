<wxs module="fmt">
var formatDuration = function (seconds) {
  var minutes = Math.max(1, Math.round(seconds / 60));
  return '约' + minutes + '分钟';
};

module.exports = {
  formatDuration: formatDuration,
};
</wxs>

<view
  class="test-card {{actionMode ? 'test-card--with-follow' : ''}}"
  bindtap="onTap"
  bindlongpress="onLongPress"
>
  <view class="test-card__image-wrap">
    <t-image t-class="test-card__image" src="{{imageLink}}" mode="aspectFill" />
  </view>
  <view class="test-card__content">
    <text class="test-card__title">{{title}}</text>
    <text class="test-card__subtitle">{{subtitle}}</text>
    <text class="test-card__meta">{{questionCount}}题 | {{fmt.formatDuration(duration)}}</text>
  </view>
  <view
    wx:if="{{actionMode}}"
    class="test-card__follow-icon"
    catchtap="onFollowIconTap"
  >
    <t-icon name="{{followed ? 'heart-filled' : 'heart'}}" size="36rpx" />
  </view>
  <view wx:if="{{tested}}" class="test-card__badge">已测试</view>

  <view wx:if="{{showMenu}}" class="test-card__mask" catchtap="onCloseMenu" catchtouchmove="noop" />
  <view wx:if="{{showMenu}}" class="test-card__menu" catchtap="noop">
    <view wx:if="{{actionMode === 'follow'}}" class="test-card__menu-item" catchtap="onFollowActionTap">
      {{followed ? '取消关注' : '关注'}}
    </view>
    <view wx:if="{{actionMode === 'unfollow'}}" class="test-card__menu-item" catchtap="onUnfollowTap">
      取消关注
    </view>
  </view>
</view>
